# Environment variables for Secure Collaborative Healthcare Learning System
# --------------------------------------------------------------------
# Database URL – SQLite for local development, PostgreSQL for production.
# Example (development):  sqlite:///./healthcare_fl.db
# Example (production):   postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<HOST>:5432/<DATABASE_NAME>"
# --------------------------------------------------------------------
# Security / JWT configuration
# --------------------------------------------------------------------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# --------------------------------------------------------------------
# Additional optional variables (override defaults in code if needed)
# --------------------------------------------------------------------
# PROJECT_NAME=Secure Collaborative Healthcare Learning System
# VERSION=1.0.0
# ENVIRONMENT=development
# BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"  # End of file
