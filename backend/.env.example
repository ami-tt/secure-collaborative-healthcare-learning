# ==============================================================================

# Environment Configuration Template

# Duplicate this file to .env and adjust sensitive credentials

# ==============================================================================



PROJECT_NAME="Secure Collaborative Healthcare Learning System"

VERSION="1.0.0"

API_V1_STR="/api/v1"

ENVIRONMENT="development"

DEBUG=True



# Security & JWT Credentials

SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY"

ALGORITHM="HS256"

ACCESS_TOKEN_EXPIRE_MINUTES=120



# Database Configuration

# PostgreSQL: postgresql://username:password@localhost:5432/healthcare_fl_db

# SQLite: sqlite:///./healthcare_fl.db

DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<HOST>:5432/<DATABASE_NAME>"



# CORS Configuration

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]



# Initial Super Admin Seed Credentials

FIRST_SUPERADMIN_EMAIL="your-admin-email@example.com"

FIRST_SUPERADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"

FIRST_SUPERADMIN_NAME="Your Administrator Name"
